{
  "name": "study-shelf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cloud:dev": "wrangler dev --config cloudflare/wrangler.toml",
    "cloud:deploy": "wrangler deploy --config cloudflare/wrangler.toml",
    "cloud:r2:create": "wrangler r2 bucket create study-shelf-books",
    "cloud:d1:create": "wrangler d1 create study-shelf-community --config cloudflare/wrangler.toml",
    "cloud:d1:init": "wrangler d1 execute study-shelf-community --remote --file=cloudflare/schema.sql --config cloudflare/wrangler.toml",
    "cloud:d1:init:local": "wrangler d1 execute study-shelf-community --local --file=cloudflare/schema.sql --config cloudflare/wrangler.toml"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "vite": "^6.3.5",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.176.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
