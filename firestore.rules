rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /users/{userId} {
      function isProfileOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read, delete: if isProfileOwner();
      
      allow create, update: if isProfileOwner()
        && request.resource.data.keys().hasOnly([
          'savedBookIds',
          'completedUnitIds',
          'theme',
          'preferredStream',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'savedBookIds',
          'completedUnitIds',
          'updatedAt'
        ])
        // Type and structural integrity constraints
        && request.resource.data.savedBookIds is list
        && request.resource.data.savedBookIds.size() <= 5000
        && request.resource.data.completedUnitIds is list
        && request.resource.data.completedUnitIds.size() <= 5000
        // Enforce that updates don't spoof system clocks
        && request.resource.data.updatedAt == request.time
        // Optional enum constraints
        && (!('theme' in request.resource.data)
          || request.resource.data.theme in ['focus', 'day'])
        && (!('preferredStream' in request.resource.data)
          || request.resource.data.preferredStream in ['PCM', 'PCB', 'Commerce', 'Humanities']);

      // Subcollection: Saved Books
      match /savedBooks/{bookId} {
        allow read, write: if isProfileOwner();
      }

      // Subcollection: Book Progress
      match /bookProgress/{bookId} {
        function hasValidBookProgress() {
          return request.resource.data.keys().hasOnly(['percent', 'updatedAt'])
            && request.resource.data.keys().hasAll(['percent', 'updatedAt'])
            && request.resource.data.percent is int
            && request.resource.data.percent >= 0
            && request.resource.data.percent <= 100
            // Secure timestamp to actual transaction execution time
            && request.resource.data.updatedAt == request.time;
        }

        allow read, delete: if isProfileOwner();
        allow create, update: if isProfileOwner() && hasValidBookProgress();
      }

      // Subcollection: Books Metadata
      match /books/{bookId} {
        function hasValidBookMetadata() {
          return request.resource.data.keys().hasOnly([
              'title',
              'originalName',
              'size',
              'contentType',
              'storagePath',
              'createdAt'
            ])
            && request.resource.data.keys().hasAll([
              'title',
              'originalName',
              'size',
              'contentType',
              'storagePath',
              'createdAt'
            ])
            && request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 180
            && request.resource.data.originalName is string
            && request.resource.data.originalName.size() <= 255
            && request.resource.data.size is int
            && request.resource.data.size > 7
            // Max size limit (20MB)
            && request.resource.data.size <= 20 * 1024 * 1024
            && request.resource.data.contentType == 'application/pdf'
            // Explicit check to verify users only link their own Cloud Storage folder path
            && request.resource.data.storagePath == 'users/' + userId + '/books/' + bookId + '.pdf'
            && request.resource.data.createdAt == request.time;
        }

        allow read, delete: if isProfileOwner();
        allow create: if isProfileOwner() && hasValidBookMetadata();
        allow update: if isProfileOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 180;
      }
    }

    match /communityBooks/{bookId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == resource.data.ownerUid;
      }

      function hasValidCommunityBook() {
        return request.resource.data.keys().hasOnly([
            'title',
            'originalName',
            'size',
            'contentType',
            'storagePath',
            'ownerUid',
            'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'title',
            'originalName',
            'size',
            'contentType',
            'storagePath',
            'ownerUid',
            'createdAt'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 180
          && request.resource.data.originalName is string
          && request.resource.data.originalName.size() <= 255
          && request.resource.data.size is int
          && request.resource.data.size > 7
          && request.resource.data.size <= 20 * 1024 * 1024
          && request.resource.data.contentType == 'application/pdf'
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.storagePath == 'community/' + request.auth.uid + '/' + bookId + '.pdf'
          && request.resource.data.createdAt == request.time;
      }

      allow read: if true;
      allow create: if request.auth != null && hasValidCommunityBook();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180;
      allow delete: if isOwner();
    }
  }
}
